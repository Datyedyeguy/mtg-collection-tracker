{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.41.2.15936",
      "templateHash": "6072328817440833867"
    }
  },
  "parameters": {
    "environmentName": {
      "type": "string",
      "allowedValues": [
        "dev",
        "staging",
        "prod"
      ],
      "metadata": {
        "description": "Short environment name, used as a suffix on all resource names."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources. Defaults to the resource group location."
      }
    },
    "dbAdminLogin": {
      "type": "string",
      "minLength": 3,
      "metadata": {
        "description": "PostgreSQL administrator login name."
      }
    },
    "dbAdminPassword": {
      "type": "securestring",
      "minLength": 16,
      "metadata": {
        "description": "PostgreSQL administrator password."
      }
    },
    "jwtSecret": {
      "type": "securestring",
      "minLength": 32,
      "metadata": {
        "description": "JWT signing secret for the API. Must be at least 32 characters."
      }
    },
    "frontendUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The URL of the deployed Static Web App frontend (used for CORS)."
      }
    },
    "alertEmail": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Email address to receive budget alert notifications. Leave empty to skip."
      }
    }
  },
  "variables": {
    "suffix": "[format('{0}-{1}', parameters('environmentName'), uniqueString(resourceGroup().id))]",
    "appServicePlanName": "[format('asp-mtg-{0}', variables('suffix'))]",
    "apiAppName": "[format('app-mtg-api-{0}', variables('suffix'))]",
    "staticWebAppName": "[format('swa-mtg-{0}', variables('suffix'))]",
    "postgresServerName": "[format('psql-mtg-{0}', variables('suffix'))]",
    "appInsightsName": "[format('appi-mtg-{0}', variables('suffix'))]",
    "logAnalyticsName": "[format('log-mtg-{0}', variables('suffix'))]",
    "corsOrigins": "[if(not(empty(parameters('frontendUrl'))), createArray(parameters('frontendUrl')), createArray())]"
  },
  "resources": {
    "monitoring": {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "monitoring",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "appInsightsName": {
            "value": "[variables('appInsightsName')]"
          },
          "logAnalyticsName": {
            "value": "[variables('logAnalyticsName')]"
          },
          "alertEmail": {
            "value": "[parameters('alertEmail')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.41.2.15936",
              "templateHash": "591638525539198059"
            }
          },
          "parameters": {
            "location": {
              "type": "string"
            },
            "appInsightsName": {
              "type": "string"
            },
            "logAnalyticsName": {
              "type": "string"
            },
            "alertEmail": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "Email address to notify when budget thresholds are crossed. Leave empty to skip alerts."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.OperationalInsights/workspaces",
              "apiVersion": "2023-09-01",
              "name": "[parameters('logAnalyticsName')]",
              "location": "[parameters('location')]",
              "properties": {
                "sku": {
                  "name": "PerGB2018"
                },
                "retentionInDays": 30,
                "features": {
                  "enableLogAccessUsingOnlyResourcePermissions": true
                }
              }
            },
            {
              "type": "Microsoft.Insights/components",
              "apiVersion": "2020-02-02",
              "name": "[parameters('appInsightsName')]",
              "location": "[parameters('location')]",
              "kind": "web",
              "properties": {
                "Application_Type": "web",
                "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName'))]",
                "RetentionInDays": 30,
                "IngestionMode": "LogAnalytics",
                "publicNetworkAccessForIngestion": "Enabled",
                "publicNetworkAccessForQuery": "Enabled"
              },
              "dependsOn": [
                "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName'))]"
              ]
            },
            {
              "type": "Microsoft.Consumption/budgets",
              "apiVersion": "2024-08-01",
              "name": "mtg-tracker-monthly-budget",
              "properties": {
                "category": "Cost",
                "amount": 150,
                "timeGrain": "Monthly",
                "timePeriod": {
                  "startDate": "2026-04-01"
                },
                "filter": {
                  "dimensions": {
                    "name": "ResourceGroupName",
                    "operator": "In",
                    "values": [
                      "[resourceGroup().name]"
                    ]
                  }
                },
                "notifications": {
                  "alert_75": {
                    "enabled": true,
                    "operator": "GreaterThan",
                    "threshold": 50,
                    "contactEmails": "[if(not(empty(parameters('alertEmail'))), createArray(parameters('alertEmail')), createArray())]",
                    "thresholdType": "Actual"
                  },
                  "alert_125": {
                    "enabled": true,
                    "operator": "GreaterThan",
                    "threshold": 83,
                    "contactEmails": "[if(not(empty(parameters('alertEmail'))), createArray(parameters('alertEmail')), createArray())]",
                    "thresholdType": "Actual"
                  },
                  "alert_150": {
                    "enabled": true,
                    "operator": "GreaterThan",
                    "threshold": 100,
                    "contactEmails": "[if(not(empty(parameters('alertEmail'))), createArray(parameters('alertEmail')), createArray())]",
                    "thresholdType": "Actual"
                  }
                }
              }
            }
          ],
          "outputs": {
            "appInsightsConnectionString": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Insights/components', parameters('appInsightsName')), '2020-02-02').ConnectionString]"
            },
            "appInsightsInstrumentationKey": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Insights/components', parameters('appInsightsName')), '2020-02-02').InstrumentationKey]"
            }
          }
        }
      }
    },
    "database": {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "database",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "serverName": {
            "value": "[variables('postgresServerName')]"
          },
          "adminLogin": {
            "value": "[parameters('dbAdminLogin')]"
          },
          "adminPassword": {
            "value": "[parameters('dbAdminPassword')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.41.2.15936",
              "templateHash": "1133943151721972602"
            }
          },
          "parameters": {
            "location": {
              "type": "string"
            },
            "serverName": {
              "type": "string"
            },
            "adminLogin": {
              "type": "string"
            },
            "adminPassword": {
              "type": "securestring"
            }
          },
          "variables": {
            "postgresVersion": "17",
            "databaseName": "mtgtracker"
          },
          "resources": [
            {
              "type": "Microsoft.DBforPostgreSQL/flexibleServers",
              "apiVersion": "2024-08-01",
              "name": "[parameters('serverName')]",
              "location": "[parameters('location')]",
              "sku": {
                "name": "Standard_B1ms",
                "tier": "Burstable"
              },
              "properties": {
                "administratorLogin": "[parameters('adminLogin')]",
                "administratorLoginPassword": "[parameters('adminPassword')]",
                "version": "[variables('postgresVersion')]",
                "storage": {
                  "storageSizeGB": 32
                },
                "backup": {
                  "backupRetentionDays": 7,
                  "geoRedundantBackup": "Disabled"
                },
                "highAvailability": {
                  "mode": "Disabled"
                },
                "network": {
                  "publicNetworkAccess": "Enabled"
                }
              }
            },
            {
              "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
              "apiVersion": "2024-08-01",
              "name": "[format('{0}/{1}', parameters('serverName'), variables('databaseName'))]",
              "properties": {
                "charset": "UTF8",
                "collation": "en_US.utf8"
              },
              "dependsOn": [
                "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('serverName'))]"
              ]
            },
            {
              "type": "Microsoft.DBforPostgreSQL/flexibleServers/firewallRules",
              "apiVersion": "2024-08-01",
              "name": "[format('{0}/{1}', parameters('serverName'), 'AllowAzureServices')]",
              "properties": {
                "startIpAddress": "0.0.0.0",
                "endIpAddress": "0.0.0.0"
              },
              "dependsOn": [
                "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('serverName'))]"
              ]
            }
          ],
          "outputs": {
            "serverFqdn": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('serverName')), '2024-08-01').fullyQualifiedDomainName]"
            }
          }
        }
      }
    },
    "webApp": {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "webApp",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "appServicePlanName": {
            "value": "[variables('appServicePlanName')]"
          },
          "apiAppName": {
            "value": "[variables('apiAppName')]"
          },
          "staticWebAppName": {
            "value": "[variables('staticWebAppName')]"
          },
          "dbConnectionString": {
            "value": "[format('Host={0};Port=5432;Database=mtgtracker;Username={1};Password={2};Ssl Mode=Require;Trust Server Certificate=true', reference('database').outputs.serverFqdn.value, parameters('dbAdminLogin'), parameters('dbAdminPassword'))]"
          },
          "jwtSecret": {
            "value": "[parameters('jwtSecret')]"
          },
          "corsOrigins": {
            "value": "[variables('corsOrigins')]"
          },
          "appInsightsConnectionString": {
            "value": "[reference('monitoring').outputs.appInsightsConnectionString.value]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "languageVersion": "2.0",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.41.2.15936",
              "templateHash": "3858975673836209812"
            }
          },
          "parameters": {
            "location": {
              "type": "string"
            },
            "appServicePlanName": {
              "type": "string"
            },
            "apiAppName": {
              "type": "string"
            },
            "staticWebAppName": {
              "type": "string"
            },
            "dbConnectionString": {
              "type": "securestring"
            },
            "jwtSecret": {
              "type": "securestring"
            },
            "corsOrigins": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "appInsightsConnectionString": {
              "type": "string"
            }
          },
          "resources": {
            "appServicePlan": {
              "type": "Microsoft.Web/serverfarms",
              "apiVersion": "2024-04-01",
              "name": "[parameters('appServicePlanName')]",
              "location": "[parameters('location')]",
              "sku": {
                "name": "B1",
                "tier": "Basic"
              },
              "kind": "linux",
              "properties": {
                "reserved": true
              }
            },
            "apiApp": {
              "type": "Microsoft.Web/sites",
              "apiVersion": "2024-04-01",
              "name": "[parameters('apiAppName')]",
              "location": "[parameters('location')]",
              "kind": "app,linux",
              "properties": {
                "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]",
                "httpsOnly": true,
                "siteConfig": {
                  "linuxFxVersion": "DOTNETCORE|10.0",
                  "ftpsState": "Disabled",
                  "http20Enabled": true,
                  "minTlsVersion": "1.2",
                  "healthCheckPath": "/api/health",
                  "appSettings": [
                    {
                      "name": "ASPNETCORE_ENVIRONMENT",
                      "value": "Production"
                    },
                    {
                      "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                      "value": "[parameters('appInsightsConnectionString')]"
                    },
                    {
                      "name": "ApplicationInsightsAgent_EXTENSION_VERSION",
                      "value": "~3"
                    },
                    {
                      "name": "JwtSettings__Secret",
                      "value": "[parameters('jwtSecret')]"
                    },
                    {
                      "name": "JwtSettings__Issuer",
                      "value": "[format('https://{0}.azurewebsites.net', parameters('apiAppName'))]"
                    },
                    {
                      "name": "JwtSettings__Audience",
                      "value": "[format('https://{0}.azurestaticapps.net', parameters('staticWebAppName'))]"
                    },
                    {
                      "name": "JwtSettings__AccessTokenExpiryMinutes",
                      "value": "15"
                    },
                    {
                      "name": "JwtSettings__RefreshTokenExpiryDays",
                      "value": "7"
                    },
                    {
                      "name": "Cors__AllowedOrigins__0",
                      "value": "[if(not(empty(parameters('corsOrigins'))), parameters('corsOrigins')[0], format('https://{0}.azurestaticapps.net', parameters('staticWebAppName')))]"
                    }
                  ],
                  "connectionStrings": [
                    {
                      "name": "DefaultConnection",
                      "connectionString": "[parameters('dbConnectionString')]",
                      "type": "Custom"
                    }
                  ]
                }
              },
              "dependsOn": [
                "appServicePlan"
              ]
            },
            "staticWebApp": {
              "type": "Microsoft.Web/staticSites",
              "apiVersion": "2024-04-01",
              "name": "[parameters('staticWebAppName')]",
              "location": "[parameters('location')]",
              "sku": {
                "name": "Free",
                "tier": "Free"
              },
              "properties": {
                "buildProperties": {
                  "skipGithubActionWorkflowGeneration": true
                }
              }
            }
          },
          "outputs": {
            "apiHostname": {
              "type": "string",
              "value": "[reference('apiApp').defaultHostName]"
            },
            "staticWebAppHostname": {
              "type": "string",
              "value": "[reference('staticWebApp').defaultHostname]"
            },
            "staticWebAppDeploymentToken": {
              "type": "securestring",
              "value": "[listSecrets('staticWebApp', '2024-04-01').properties.apiKey]"
            }
          }
        }
      },
      "dependsOn": [
        "database",
        "monitoring"
      ]
    }
  },
  "outputs": {
    "apiHostname": {
      "type": "string",
      "metadata": {
        "description": "The hostname of the deployed API (e.g. app-mtg-api-prod-abc123.azurewebsites.net)."
      },
      "value": "[reference('webApp').outputs.apiHostname.value]"
    },
    "staticWebAppHostname": {
      "type": "string",
      "metadata": {
        "description": "The default hostname of the Static Web App."
      },
      "value": "[reference('webApp').outputs.staticWebAppHostname.value]"
    },
    "staticWebAppDeploymentToken": {
      "type": "securestring",
      "metadata": {
        "description": "The deployment token for Static Web Apps CI/CD."
      },
      "value": "[listOutputsWithSecureValues('webApp', '2025-04-01').staticWebAppDeploymentToken]"
    },
    "dbServerFqdn": {
      "type": "string",
      "metadata": {
        "description": "The PostgreSQL server FQDN."
      },
      "value": "[reference('database').outputs.serverFqdn.value]"
    }
  }
}